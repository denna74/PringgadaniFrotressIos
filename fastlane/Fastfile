default_platform(:ios)

def app_identifier
  ENV.fetch("IOS_BUNDLE_IDENTIFIER", "com.pringgadanifortress")
end

def team_identifier
  ENV.fetch("IOS_TEAM_ID") { UI.user_error!("Set the IOS_TEAM_ID environment variable.") }
end

def profile_name
  ENV.fetch("IOS_PROVISIONING_PROFILE_NAME", "PringgadaniFortress AppStore")
end

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"),
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Create certificates and provisioning profiles"
  lane :init_certificates do
    api_key = app_store_api_key

    cert(
      api_key: api_key,
      output_path: "build/certs"
    )

    sigh(
      api_key: api_key,
      app_identifier: app_identifier,
      provisioning_name: profile_name,
      output_path: "build/profiles",
      force: true
    )
  end

  desc "Fetch certificates and provisioning profiles"
  lane :fetch_certificates do
    api_key = app_store_api_key

    cert(
      api_key: api_key,
      output_path: "build/certs"
    )

    sigh(
      api_key: api_key,
      app_identifier: app_identifier,
      provisioning_name: profile_name,
      output_path: "build/profiles",
      readonly: true
    )
  end

  desc "Automated pipeline to fetch certificates, build the Xcode project, and publish to TestFlight"
  lane :deploy_testflight do
    api_key = app_store_api_key
    project = "build/ios/PringgadaniFortress.xcodeproj"
    build_number = ENV.fetch("IOS_BUILD_NUMBER", ENV.fetch("GITHUB_RUN_NUMBER", "1"))

    sigh(
      api_key: api_key,
      app_identifier: app_identifier,
      output_path: "build/profiles",
      force: true,
      provisioning_name: profile_name
    )

    increment_build_number(build_number: build_number, xcodeproj: project)

    gym(
      project: project,
      scheme: "PringgadaniFortress",
      output_directory: "build/ios",
      output_name: "PringgadaniFortress.ipa",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' DEVELOPMENT_TEAM=#{team_identifier} PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    )

    pilot(
      ipa: "build/ios/PringgadaniFortress.ipa",
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
