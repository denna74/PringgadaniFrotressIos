default_platform(:ios)

def app_identifier
  ENV.fetch("IOS_BUNDLE_IDENTIFIER", "com.pringgadanifortress")
end

def profile_name
  ENV.fetch("IOS_PROVISIONING_PROFILE_NAME", "PringgadaniFortress AppStore")
end

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"),
    is_key_content_base64: true
  )
end

platform :ios do
  desc "List in-app purchase products and their App Store Connect state"
  lane :iap_products do
    api_key = app_store_api_key

    app = Spaceship::ConnectAPI::App.find(app_identifier)
    response = Spaceship::ConnectAPI.client.get("apps/#{app.id}/inAppPurchasesV2")
    products = response.fetch("data")
    UI.message("IAP count: #{products.size}")
    products.each do |product|
      attributes = product.fetch("attributes")
      UI.message("#{attributes['productId']}  state=#{attributes['state']}  name=#{attributes['name']}")
    end
  end

  desc "Automated pipeline to fetch certificates, build the Xcode project, and publish to TestFlight"
  lane :deploy_testflight do
    api_key = app_store_api_key
    project = "build/ios/PringgadaniFortress.xcodeproj"
    build_number = ENV.fetch("IOS_BUILD_NUMBER", ENV.fetch("GITHUB_RUN_NUMBER", "1"))

    sigh(
      api_key: api_key,
      app_identifier: app_identifier,
      output_path: "build/profiles",
      force: true,
      provisioning_name: profile_name
    )

    increment_build_number(build_number: build_number, xcodeproj: project)

    gym(
      project: project,
      scheme: "PringgadaniFortress",
      output_directory: "build/ios",
      output_name: "PringgadaniFortress.ipa",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    )

    ipa_path = "build/ios/PringgadaniFortress.ipa"
    ipa_size = File.size(ipa_path)
    max_ipa_size = 200_000_000
    UI.user_error!("IPA is #{format('%.1f', ipa_size / 1_000_000.0)} MB; it must be smaller than 200 MB.") if ipa_size >= max_ipa_size

    pilot(
      ipa: ipa_path,
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
